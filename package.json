{
  "name": "vivbakes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "wrangler deploy",
    "verify:bindings": "node scripts/verify-bindings.mjs",
    "migrate:local": "wrangler d1 migrations apply vivbakes --local",
    "migrate:remote": "wrangler d1 migrations apply vivbakes --remote",
    "verify:styles": "node scripts/verify-admin-styles.mjs",
    "preview:admin": "node scripts/build-admin-preview.mjs",
    "verify:vendor": "node scripts/vendor-webp-encoder.mjs --check",
    "verify:routes": "node scripts/verify-routes.mjs",
    "seed:dry": "node scripts/seed.mjs --dry-run",
    "seed:local": "node scripts/seed.mjs",
    "seed:remote": "node scripts/seed.mjs --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@jsquash/webp": "^1.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.36.0"
  },
  "dependencies": {
    "jose": "^6.2.10"
  }
}
